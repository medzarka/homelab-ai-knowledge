# ==============================================================================
# AI Knowledge & Agent Long-Term Memory Stack (.env)
# Optimized for ARM64 (Oracle Cloud Flex / Orange Pi 5 Plus)
# ==============================================================================

# --- 1. Storage & Runtime Paths ---
DATA_DIR=/srv/data/ai-knowledge

# --- 2. Ingress & Public Routing Domains ---
QDRANT_DOMAIN=qdrant.example.com
MEM0_DOMAIN=mem0.example.com
NEO4J_DOMAIN=neo4j.example.com

# --- 3. Qdrant Vector Database ---
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
# Optional API Key for securing Qdrant vector database (leave empty for open internal access)
QDRANT_API_KEY=
# Maximum parallel search worker threads (Recommended: 2 for 2-vCPU VMs)
QDRANT_SEARCH_THREADS=2

# --- 4. Mem0 Intelligent Memory Engine ---
MEM0_API_PORT=8000
# Master API Key for client authorization to Mem0 (Leave empty to allow open internal access)
MEM0_API_KEY=generate_a_secure_mem0_api_key
# Vector store provider: qdrant (recommended) or pgvector
MEM0_VECTOR_STORE=qdrant
MEM0_COLLECTION=memories

# Neo4j Graph Database Authentication
NEO4J_PASSWORD=generate_a_secure_neo4j_password
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# LLM & Embedding Routing via LiteLLM Gateway
LITELLM_API_BASE=http://litellm:4000/v1
LITELLM_MASTER_KEY=your_litellm_master_key_here

# Default Models for Memory Extraction & Semantic Vector Embeddings
MEM0_LLM_MODEL=hermes-default
MEM0_EMBEDDING_MODEL=BAAI/bge-m3

# --- 5. Homelab Knowledge MCP Server & Multi-Modal Ingestion ---
KNOWLEDGE_MCP_PORT=8095
KNOWLEDGE_MCP_DOMAIN=knowledge-mcp.example.com
QDRANT_COLLECTION_WORKSPACE=workspace
PDF_RENDER_DPI=150
MAX_CONCURRENT_INDEXING_JOBS=1
INDEXING_REQUEST_TIMEOUT=300

# Embedding Provider (Primary on Compute Node TEI, Fallback via LiteLLM)
EMBEDDING_PRIMARY_URL=http://compute_embeddings:80/embed
EMBEDDING_FALLBACK_URL=http://litellm:4000/v1/embeddings
EMBEDDING_MODEL=BAAI/bge-m3

# Reranker Provider (Primary on Compute Node TEI, Fallback via LiteLLM)
RERANKER_PRIMARY_URL=http://compute_reranker:80/rerank
RERANKER_FALLBACK_URL=http://litellm:4000/v1/rerank
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Vision Provider (Primary on Local Compute Node Ollama, Fallback via LiteLLM)
VISION_PRIMARY_PROVIDER=local
VISION_PRIMARY_URL=http://compute_ollama:11434/api/chat
VISION_PRIMARY_MODEL=qwen2.5vl:3b
VISION_FALLBACK_PROVIDER=litellm
VISION_FALLBACK_URL=http://litellm:4000/v1/chat/completions
VISION_FALLBACK_MODEL=google/gemini-2.0-flash

# Audio STT Provider (Primary on Compute Node Speaches STT, Fallback via LiteLLM)
AUDIO_PRIMARY_URL=http://compute_speaches:8000/v1/audio/transcriptions
AUDIO_PRIMARY_MODEL=Systran/faster-whisper-large-v3
AUDIO_FALLBACK_URL=http://litellm:4000/v1/audio/transcriptions
AUDIO_FALLBACK_MODEL=openai/whisper-1

# --- 6. Docker Network ---
SHARED_NETWORK=shared_net
